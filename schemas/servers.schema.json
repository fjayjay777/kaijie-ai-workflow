{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "servers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "transport",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "transport": {
            "const": "http"
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        }
      }
    }
  }
}
